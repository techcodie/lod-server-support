@@ -0,0 +1,60 @@
+package dev.vox.lss.verifier;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.UUID;
+
+/** Reflective control of the runtime Via fixture — no compile-time Via dependency. */
+public final class ViaFixtureControl {
+
+    private static final String VIA_CLASS = "com.viaversion.viaversion.api.Via";
+    private static final String VIA_API_CLASS = "com.viaversion.viaversion.api.ViaAPI";
+
+    private ViaFixtureControl() {}
+
+    public static void reset() {
+        setStatic("API", null);
+        setStatic("throwOnGetApi", null);
+    }
+
+    public static void setThrowOnGetApi(RuntimeException ex) {
+        setStatic("throwOnGetApi", ex);
+    }
+
+    public static void setNullApi() {
+        setStatic("API", null);
+    }
+
+    public static void setPlayerVersionForPlayer(UUID player, int protocol, int defaultForOthers) {
+        try {
+            Class<?> apiInterface = Class.forName(VIA_API_CLASS);
+            Object api = Proxy.newProxyInstance(
+                    apiInterface.getClassLoader(),
+                    new Class<?>[] {apiInterface},
+                    (proxy, method, args) -> {
+                        if ("getPlayerVersion".equals(method.getName()) && args != null && args.length == 1) {
+                            Object arg = args[0];
+                            if (arg instanceof UUID uuid && uuid.equals(player)) {
+                                return protocol;
+                            }
+                            return defaultForOthers;
+                        }
+                        return 0;
+                    });
+            setStatic("API", api);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError("Via fixture control failed", e);
+        }
+    }
+
+    private static void setStatic(String field, Object value) {
+        try {
+            Class<?> via = Class.forName(VIA_CLASS);
+            Field f = via.getDeclaredField(field);
+            f.setAccessible(true);
+            f.set(null, value);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError("Via fixture control failed setting " + field, e);
+        }
+    }
+}
