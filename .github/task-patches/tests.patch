@@ -0,0 +1,69 @@
+package dev.vox.lss.verifier.paper;
+
+import dev.vox.lss.paper.LSSPaperPlugin;
+import dev.vox.lss.paper.PaperConfig;
+import dev.vox.lss.paper.PaperRequestProcessingService;
+import org.bukkit.entity.Player;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+
+import net.minecraft.server.level.ServerPlayer;
+
+/**
+ * Type-based reflection into {@link LSSPaperPlugin} — no dependency on private
+ * field or method names from the base repository.
+ */
+public final class PaperProductionHarness {
+
+    private PaperProductionHarness() {}
+
+    public static LSSPaperPlugin newPlugin(PaperConfig config, PaperRequestProcessingService service)
+            throws Exception {
+        var plugin = new LSSPaperPlugin();
+        injectConfig(plugin, config);
+        injectRequestService(plugin, service);
+        return plugin;
+    }
+
+    public static void injectConfig(LSSPaperPlugin plugin, PaperConfig config) throws Exception {
+        for (Field field : LSSPaperPlugin.class.getDeclaredFields()) {
+            if (field.getType() == PaperConfig.class && !Modifier.isStatic(field.getModifiers())) {
+                field.setAccessible(true);
+                field.set(plugin, config);
+                return;
+            }
+        }
+        throw new IllegalStateException("no PaperConfig field on LSSPaperPlugin");
+    }
+
+    public static void injectRequestService(LSSPaperPlugin plugin, PaperRequestProcessingService service)
+            throws Exception {
+        for (Field field : LSSPaperPlugin.class.getDeclaredFields()) {
+            if (field.getType() == PaperRequestProcessingService.class
+                    && !Modifier.isStatic(field.getModifiers())) {
+                field.setAccessible(true);
+                field.set(plugin, service);
+                return;
+            }
+        }
+        throw new IllegalStateException("no PaperRequestProcessingService field on LSSPaperPlugin");
+    }
+
+    public static void invokeProductionHandshake(LSSPaperPlugin plugin, Player bukkit,
+                                                  ServerPlayer nms, byte[] data) throws Exception {
+        for (Method method : LSSPaperPlugin.class.getDeclaredMethods()) {
+            if (method.getParameterCount() != 3) {
+                continue;
+            }
+            Class<?>[] params = method.getParameterTypes();
+            if (params[0] == Player.class && params[1] == ServerPlayer.class && params[2] == byte[].class) {
+                method.setAccessible(true);
+                method.invoke(plugin, bukkit, nms, data);
+                return;
+            }
+        }
+        throw new IllegalStateException("no production handshake method on LSSPaperPlugin");
+    }
+}
