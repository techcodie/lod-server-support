+package dev.vox.lss.paper;
+
+import com.viaversion.viaversion.api.Via;
+import dev.vox.lss.common.LSSConstants;
+import dev.vox.lss.common.compat.V16CompatManager;
+import dev.vox.lss.common.compat.WireDialectTracker;
+import io.netty.buffer.Unpooled;
+import net.minecraft.SharedConstants;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.server.level.ServerPlayer;
+import org.apache.logging.log4j.Level;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.core.LogEvent;
+import org.apache.logging.log4j.core.LoggerContext;
+import org.apache.logging.log4j.core.appender.AbstractAppender;
+import org.apache.logging.log4j.core.config.Property;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyBoolean;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.Mockito.atLeastOnce;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * Production Paper wiring: the private join-time handshake handler must consult ViaVersion
+ * when the toggle is on — not test-only static overloads that inject protocol integers.
+ */
+class LSSPaperPluginViaProductionTest {
+
+    private static final UUID PLAYER = UUID.randomUUID();
+    private static final int V = LSSConstants.PROTOCOL_VERSION;
+    private static final int VOXEL_CAPS = LSSConstants.CAPABILITY_VOXEL_COLUMNS;
+    private static final int VIA_PROTOCOL = 763;
+
+    @BeforeAll
+    static void setup() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @BeforeEach
+    void resetViaStub() {
+        Via.API = null;
+        Via.throwOnGetApi = null;
+    }
+
+    @Test
+    void pluginConstructsWithoutViaVersionInstalled() {
+        assertDoesNotThrow(LSSPaperPlugin::new,
+                "Paper must start without ViaVersion on the classpath");
+    }
+
+    @Test
+    void viaMismatchOnALegacyHandshakeIsDeniedSilentlyThroughProductionEntry() throws Exception {
+        Via.API = uuid -> uuid.equals(PLAYER) ? VIA_PROTOCOL : -1;
+        try (MockedStatic<PaperPayloadHandler> payloads = mockStatic(PaperPayloadHandler.class)) {
+            for (int version : new int[]{19, 18, 16}) {
+                var service = mockRequestService();
+                invokePrivateHandshake(pluginWith(config(true), service),
+                        mock(Player.class), mockNmsPlayer(), handshakeFrame(version, VOXEL_CAPS));
+                verify(service, never()).enqueueRegister(any(), anyInt(), any(), any());
+            }
+            payloads.verify(
+                    () -> PaperPayloadHandler.sendSessionConfig(
+                            any(), anyInt(), anyBoolean(), anyInt(), anyBoolean()),
+                    never());
+            payloads.verify(
+                    () -> PaperPayloadHandler.sendSessionConfigV16(
+                            any(), anyBoolean(), anyInt(), anyInt(), anyInt(), anyBoolean()),
+                    never());
+        }
+    }
+
+    @Test
+    void viaMismatchNeverTouchesACurrentClientThroughProductionEntry() throws Exception {
+        Via.API = uuid -> uuid.equals(PLAYER) ? VIA_PROTOCOL : -1;
+        var service = mockRequestService();
+        invokePrivateHandshake(pluginWith(config(true), service),
+                mock(Player.class), mockNmsPlayer(), handshakeFrame(V, VOXEL_CAPS));
+        verify(service, atLeastOnce()).enqueueRegister(any(), anyInt(), any(), any());
+    }
+
+    @Test
+    void throwingGetApiLeavesLegacyHandshakeUnchangedThroughProductionEntry() throws Exception {
+        Via.throwOnGetApi = new IllegalArgumentException("Via not initialized");
+        var service = mockRequestService();
+        invokePrivateHandshake(pluginWith(config(true), service),
+                mock(Player.class), mockNmsPlayer(), handshakeFrame(19, VOXEL_CAPS));
+        verify(service, atLeastOnce()).enqueueRegister(any(), anyInt(), any(), any());
+    }
+
+    @Test
+    void noViaSignalLeavesLegacyHandshakeUnchangedThroughProductionEntry() throws Exception {
+        Via.API = null;
+        var service = mockRequestService();
+        invokePrivateHandshake(pluginWith(config(true), service),
+                mock(Player.class), mockNmsPlayer(), handshakeFrame(19, VOXEL_CAPS));
+        verify(service, atLeastOnce()).enqueueRegister(any(), anyInt(), any(), any());
+    }
+
+    @Test
+    void viaMismatchLogsBothMinecraftProtocolNumbers() throws Exception {
+        Via.API = uuid -> uuid.equals(PLAYER) ? VIA_PROTOCOL : -1;
+        int nativeProtocol = SharedConstants.getProtocolVersion();
+        var plugin = pluginWith(config(true), null);
+        try (var capture = new LssLogCapture()) {
+            invokePrivateHandshake(plugin, mock(Player.class), mockNmsPlayer(),
+                    handshakeFrame(19, VOXEL_CAPS));
+            assertTrue(capture.rows().stream().anyMatch(row ->
+                            row.message().contains(String.valueOf(VIA_PROTOCOL))
+                                    && row.message().contains(String.valueOf(nativeProtocol))),
+                    "operators must see both Via-reported and server Minecraft protocol numbers");
+        }
+    }
+
+    @Test
+    void toggleOffIgnoresViaMismatchThroughProductionEntry() throws Exception {
+        Via.API = uuid -> uuid.equals(PLAYER) ? VIA_PROTOCOL : -1;
+        var config = config(true);
+        config.enableViaMismatchGuard = false;
+        var service = mockRequestService();
+        invokePrivateHandshake(pluginWith(config, service),
+                mock(Player.class), mockNmsPlayer(), handshakeFrame(19, VOXEL_CAPS));
+        verify(service, atLeastOnce()).enqueueRegister(any(), anyInt(), any(), any());
+    }
+
+    private static PaperConfig config(boolean enabled) {
+        var config = new PaperConfig();
+        config.enabled = enabled;
+        return config;
+    }
+
+    private static LSSPaperPlugin pluginWith(PaperConfig config, PaperRequestProcessingService service)
+            throws Exception {
+        var plugin = new LSSPaperPlugin();
+        setField(plugin, "lssConfig", config);
+        setField(plugin, "requestService", service);
+        return plugin;
+    }
+
+    private static PaperRequestProcessingService mockRequestService() {
+        var service = mock(PaperRequestProcessingService.class);
+        when(service.getV16CompatManager()).thenReturn(new V16CompatManager());
+        when(service.getDialectTracker()).thenReturn(new WireDialectTracker());
+        return service;
+    }
+
+    private static ServerPlayer mockNmsPlayer() {
+        var nms = mock(ServerPlayer.class);
+        when(nms.getUUID()).thenReturn(PLAYER);
+        when(nms.getName()).thenReturn(Component.literal("vx9m"));
+        return nms;
+    }
+
+    private static void invokePrivateHandshake(LSSPaperPlugin plugin, Player bukkit,
+                                               ServerPlayer nms, byte[] data) throws Exception {
+        Method m = LSSPaperPlugin.class.getDeclaredMethod(
+                "handleHandshake", Player.class, ServerPlayer.class, byte[].class);
+        m.setAccessible(true);
+        m.invoke(plugin, bukkit, nms, data);
+    }
+
+    private static void setField(Object target, String name, Object value) throws Exception {
+        Field f = target.getClass().getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    private static byte[] handshakeFrame(int version, int caps) {
+        var b = new FriendlyByteBuf(Unpooled.buffer());
+        b.writeVarInt(version);
+        b.writeVarInt(caps);
+        byte[] out = new byte[b.readableBytes()];
+        b.readBytes(out);
+        b.release();
+        return out;
+    }
+
+    private record LogRow(Level level, String message) {}
+
+    private static final class LssLogCapture extends AbstractAppender implements AutoCloseable {
