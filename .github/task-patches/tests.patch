+package dev.vox.lss.networking.server;
+
+import dev.vox.lss.verifier.ViaClasspathIsolation;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Production Fabric wiring exercised in isolated JVMs so Via-absent and Via-present
+ * classpaths are real — not simulated by nulling a stub field in-process.
+ */
+class LSSServerNetworkingHandshakeGlueTest {
+
+    private static final String ABSENT_MAIN = "dev.vox.lss.verifier.fabric.ViaAbsentFabricMain";
+    private static final String PRESENT_MAIN = "dev.vox.lss.verifier.fabric.ViaPresentFabricMain";
+
+    private static String testClasspath() {
+        return ViaClasspathIsolation.runtimeClasspath();
+    }
+
+    @Test
+    void viaClassesAbsentLegacyHandshakeProceedsThroughProductionEntry() {
+        ViaClasspathIsolation.runAbsentMain(ABSENT_MAIN, "legacy_handshake", testClasspath());
+    }
+
+    @Test
+    void throwingGetApiLeavesLegacyHandshakeUnchangedThroughProductionEntry() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "throwing_get_api", testClasspath());
+    }
+
+    @Test
+    void providerPresentNullApiLeavesLegacyHandshakeUnchangedThroughProductionEntry() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "provider_present_null_api", testClasspath());
+    }
+
+    @Test
+    void viaMismatchDeniesEveryLegacyDialectSilentlyThroughProductionEntry() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "via_mismatch_legacy", testClasspath());
+    }
+
+    @Test
+    void viaMismatchNeverTouchesACurrentClientThroughProductionEntry() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "via_mismatch_current", testClasspath());
+    }
+
+    @Test
+    void versionMismatchOutranksViaGuardThroughProductionEntry() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "version_mismatch_outranks", testClasspath());
+    }
+
+    @Test
+    void toggleOffIgnoresViaMismatchThroughProductionEntry() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "toggle_off", testClasspath());
+    }
+
+    @Test
+    void viaMismatchLogsBothMinecraftProtocolNumbers() {
+        ViaClasspathIsolation.runPresentMain(PRESENT_MAIN, "via_mismatch_logs", testClasspath());
+    }
+}
diff --git a/fabric/src/test/java/dev/vox/lss/verifier/ViaClasspathIsolation.java b/fabric/src/test/java/dev/vox/lss/verifier/ViaClasspathIsolation.java
new file mode 100644
index 0000000..ca29f7d
--- /dev/null
+++ b/fabric/src/test/java/dev/vox/lss/verifier/ViaClasspathIsolation.java
@@ -0,0 +1,215 @@
+package dev.vox.lss.verifier;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.jar.Attributes;
+import java.util.jar.JarEntry;
+import java.util.jar.JarOutputStream;
+import java.util.jar.Manifest;
+import java.util.stream.Collectors;
+
+/**
+ * Spawns isolated JVMs for Via classpath scenarios. Via stubs are compiled into a
+ * temporary fixture JAR on demand — never checked into {@code src/test}.
+ */
+public final class ViaClasspathIsolation {
+
+    public static final String MARKER_PASS = "VIACLASSPATH_PASS";
+
+    /** Full runtime classpath for spawning isolated JVMs (Gradle test workers omit {@code java.class.path}). */
+    public static String runtimeClasspath() {
+        String fromEnv = System.getenv("VERIFIER_TEST_CLASSPATH");
+        if (fromEnv != null && !fromEnv.isBlank()) {
+            return fromEnv;
+        }
+        return System.getProperty("java.class.path", "");
+    }
+
+    private static volatile Path cachedFixtureJar;
+
+    private ViaClasspathIsolation() {}
+
+    public static boolean isViaRelated(String entry) {
+        if (entry == null || entry.isBlank()) {
+            return false;
+        }
+        String lower = entry.toLowerCase(Locale.ROOT).replace('\\', '/');
+        return lower.contains("com/viaversion")
+                || lower.contains("viaversion")
+                || lower.contains("via-version")
+                || lower.contains("viafabric")
+                || lower.contains("via-fixture");
+    }
+
+    public static String absentClasspath(String rawClasspath) {
+        if (rawClasspath == null || rawClasspath.isBlank()) {
+            return "";
+        }
+        return java.util.Arrays.stream(rawClasspath.split(File.pathSeparator))
+                .filter(part -> !part.isBlank() && !isViaRelated(part))
+                .collect(Collectors.joining(File.pathSeparator));
+    }
+
+    public static Path compileViaFixtureJar() throws IOException {
+        Path existing = cachedFixtureJar;
+        if (existing != null && Files.isRegularFile(existing)) {
+            return existing;
+        }
+        synchronized (ViaClasspathIsolation.class) {
+            if (cachedFixtureJar != null && Files.isRegularFile(cachedFixtureJar)) {
+                return cachedFixtureJar;
+            }
+            Path work = Files.createTempDirectory("lss-via-fixture-src-");
+            Path apiDir = work.resolve("com/viaversion/viaversion/api");
+            Files.createDirectories(apiDir);
+            Files.writeString(apiDir.resolve("ViaAPI.java"), VIA_API_SOURCE, StandardCharsets.UTF_8);
+            Files.writeString(apiDir.resolve("Via.java"), VIA_SOURCE, StandardCharsets.UTF_8);
+
+            Path classes = work.resolve("classes");
+            Files.createDirectories(classes);
+            int javac = runCommand(List.of(
+                    "javac",
+                    "-d", classes.toString(),
+                    apiDir.resolve("ViaAPI.java").toString(),
+                    apiDir.resolve("Via.java").toString()));
+            if (javac != 0) {
+                throw new IOException("javac failed compiling Via fixture (" + javac + ")");
+            }
+
+            Path jar = work.resolve("via-fixture.jar");
+            writeJar(jar, classes);
+            cachedFixtureJar = jar;
+            return jar;
+        }
+    }
+
+    public static void runAbsentMain(String mainClass, String scenario, String rawClasspath) {
+        String classpath = absentClasspath(rawClasspath);
+        assertNoViaEntries(classpath);
+        runIsolated(mainClass, scenario, classpath);
+    }
+
+    public static void runPresentMain(String mainClass, String scenario, String rawClasspath) {
+        try {
+            Path fixture = compileViaFixtureJar();
+            String base = absentClasspath(rawClasspath);
+            assertNoViaEntries(base);
+            String classpath = base + File.pathSeparator + fixture.toAbsolutePath();
+            runIsolated(mainClass, scenario, classpath);
+        } catch (IOException e) {
+            throw new AssertionError("failed to build Via fixture JAR", e);
+        }
+    }
+
+    private static void assertNoViaEntries(String classpath) {
+        for (String part : classpath.split(File.pathSeparator)) {
+            if (isViaRelated(part)) {
+                throw new AssertionError("Via-related entry must not be on absent classpath: " + part);
+            }
+        }
+    }
+
+    private static void runIsolated(String mainClass, String scenario, String classpath) {
+        List<String> cmd = new ArrayList<>();
+        cmd.add(javaBinary());
+        cmd.add("-cp");
+        cmd.add(classpath);
+        cmd.add(mainClass);
+        cmd.add(scenario);
+
+        ProcessBuilder pb = new ProcessBuilder(cmd);
+        pb.redirectErrorStream(true);
+        try {
+            Process proc = pb.start();
+            String output;
+            try (var reader = new BufferedReader(
+                    new InputStreamReader(proc.getInputStream(), StandardCharsets.UTF_8))) {
+                output = reader.lines().collect(Collectors.joining("\n"));
+            }
+            int code = proc.waitFor();
+            if (code != 0 || !output.contains(MARKER_PASS)) {
+                throw new AssertionError(
+                        "isolated JVM failed for " + mainClass + " scenario=" + scenario
+                                + " exit=" + code + "\nclasspath=" + classpath + "\noutput:\n" + output);
+            }
+        } catch (IOException | InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError("failed to launch isolated JVM for " + mainClass, e);
+        }
+    }
+
+    private static String javaBinary() {
+        String home = System.getProperty("java.home");
+        return home + File.separator + "bin" + File.separator + "java";
+    }
+
+    private static int runCommand(List<String> cmd) throws IOException {
+        Process proc = new ProcessBuilder(cmd).inheritIO().start();
+        try {
+            return proc.waitFor();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("command interrupted: " + cmd, e);
+        }
+    }
+
+    private static void writeJar(Path jar, Path classesRoot) throws IOException {
+        Manifest manifest = new Manifest();
+        manifest.getMainAttributes().put(Attributes.Name.MANIFEST_VERSION, "1.0");
+        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar), manifest)) {
+            try (var walk = Files.walk(classesRoot)) {
+                for (Path path : walk.filter(Files::isRegularFile).toList()) {
+                    String entryName = classesRoot.relativize(path).toString().replace('\\', '/');
+                    jos.putNextEntry(new JarEntry(entryName));
+                    Files.copy(path, jos);
+                    jos.closeEntry();
+                }
+            }
+        }
+    }
+
+    private static final String VIA_API_SOURCE = """
+            package com.viaversion.viaversion.api;
+
+            import java.util.UUID;
+
+            public interface ViaAPI<T> {
+                int getPlayerVersion(T player);
+
+                @SuppressWarnings("unchecked")
+                default int getPlayerVersion(UUID uuid) {
+                    return getPlayerVersion((T) uuid);
+                }
+            }
+            """;
+
+    private static final String VIA_SOURCE = """
+            package com.viaversion.viaversion.api;
+
+            import java.util.UUID;
+
+            public final class Via {
+                private Via() {}
+
+                public static volatile ViaAPI<UUID> API;
+                public static volatile RuntimeException throwOnGetApi;
+
+                @SuppressWarnings("rawtypes")
+                public static ViaAPI getAPI() {
+                    RuntimeException t = throwOnGetApi;
+                    if (t != null) {
+                        throw t;
+                    }
+                    return API;
+                }
+            }
+            """;
+}
diff --git a/fabric/src/test/java/dev/vox/lss/verifier/ViaFixtureControl.java b/fabric/src/test/java/dev/vox/lss/verifier/ViaFixtureControl.java
