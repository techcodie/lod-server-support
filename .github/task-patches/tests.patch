diff --git a/fabric/src/test/java/dev/vox/lss/networking/server/LSSServerNetworkingHandshakeGlueTest.java b/fabric/src/test/java/dev/vox/lss/networking/server/LSSServerNetworkingHandshakeGlueTest.java
