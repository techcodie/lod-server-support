+package dev.vox.lss.verifier.fabric;
+
+import dev.vox.lss.common.LSSConstants;
+import dev.vox.lss.common.compat.V16CompatManager;
+import dev.vox.lss.common.compat.WireDialectTracker;
+import dev.vox.lss.config.LSSServerConfig;
+import dev.vox.lss.networking.payloads.HandshakeC2SPayload;
+import dev.vox.lss.networking.payloads.SessionConfigS2CPayload;
+import dev.vox.lss.networking.server.LSSServerNetworking;
+import dev.vox.lss.networking.server.RequestProcessingService;
+import dev.vox.lss.verifier.ViaClasspathIsolation;
+import dev.vox.lss.verifier.ViaFixtureControl;
+import net.minecraft.SharedConstants;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.server.level.ServerPlayer;
+import org.apache.logging.log4j.Level;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.core.LogEvent;
+import org.apache.logging.log4j.core.LoggerContext;
+import org.apache.logging.log4j.core.appender.AbstractAppender;
+import org.apache.logging.log4j.core.config.Property;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.Mockito.atLeastOnce;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/** Isolated JVM entry: Via fixture JAR is the only Via provider on the classpath. */
+public final class ViaPresentFabricMain {
+
+    private static final UUID PLAYER = UUID.fromString("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee");
+    private static final int V = LSSConstants.PROTOCOL_VERSION;
+    private static final int VOXEL_CAPS = LSSConstants.CAPABILITY_VOXEL_COLUMNS;
+    private static final int VIA_PROTOCOL = 763;
+
+    private ViaPresentFabricMain() {}
+
+    public static void main(String[] args) throws Exception {
+        if (args.length != 1) {
+            System.err.println("usage: ViaPresentFabricMain <scenario>");
+            System.exit(2);
+        }
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        resetViaStub();
+        boolean priorToggle = LSSServerConfig.CONFIG.enableViaMismatchGuard;
+        LSSServerConfig.CONFIG.enableViaMismatchGuard = true;
+        try {
+            switch (args[0]) {
+                case "throwing_get_api" -> throwingGetApiLeavesLegacyHandshakeUnchanged();
+                case "provider_present_null_api" -> providerPresentNullApiLeavesLegacyHandshakeUnchanged();
+                case "via_mismatch_legacy" -> viaMismatchDeniesEveryLegacyDialectSilently();
+                case "via_mismatch_current" -> viaMismatchNeverTouchesACurrentClient();
+                case "version_mismatch_outranks" -> versionMismatchOutranksViaGuard();
+                case "toggle_off" -> toggleOffIgnoresViaMismatch();
+                case "via_mismatch_logs" -> viaMismatchLogsBothMinecraftProtocolNumbers();
+                default -> {
+                    System.err.println("unknown scenario: " + args[0]);
+                    System.exit(2);
+                }
+            }
+        } catch (Throwable t) {
+            t.printStackTrace(System.err);
+            System.exit(1);
+        } finally {
+            LSSServerConfig.CONFIG.enableViaMismatchGuard = priorToggle;
+        }
+        System.out.println(ViaClasspathIsolation.MARKER_PASS);
+    }
+
+    private static void resetViaStub() {
+        ViaFixtureControl.reset();
+    }
+
+    private static void throwingGetApiLeavesLegacyHandshakeUnchanged() {
+        ViaFixtureControl.setThrowOnGetApi(new IllegalArgumentException("Via not initialized"));
+        var service = mockRequestService();
+        if (repliesAfterLegacyHandshake(19, service).isEmpty()) {
+            System.err.println("throwing Via entry must fail open");
+            System.exit(1);
+        }
+        verify(service, atLeastOnce()).registerPlayer(any(), anyInt());
+    }
+
+    private static void providerPresentNullApiLeavesLegacyHandshakeUnchanged() {
+        ViaFixtureControl.setNullApi();
+        var service = mockRequestService();
+        if (repliesAfterLegacyHandshake(19, service).isEmpty()) {
+            System.err.println("null Via API must fail open");
+            System.exit(1);
+        }
+        verify(service, atLeastOnce()).registerPlayer(any(), anyInt());
+    }
+
+    private static void viaMismatchDeniesEveryLegacyDialectSilently() {
+        ViaFixtureControl.setPlayerVersionForPlayer(PLAYER, VIA_PROTOCOL, -1);
+        for (int version : new int[]{19, 18, 16}) {
+            var service = mockRequestService();
+            if (!repliesAfterLegacyHandshake(version, service).isEmpty()) {
+                System.err.println("legacy protocol " + version + " must be denied on Via mismatch");
+                System.exit(1);
+            }
+            verify(service, never()).registerPlayer(any(), anyInt());
+        }
+    }
+
+    private static void viaMismatchNeverTouchesACurrentClient() {
+        ViaFixtureControl.setPlayerVersionForPlayer(PLAYER, VIA_PROTOCOL, -1);
+        var service = mockRequestService();
+        var player = mockPlayer();
+        var replies = new ArrayList<SessionConfigS2CPayload>();
+        LSSServerNetworking.handleHandshake(
+                new HandshakeC2SPayload(V, VOXEL_CAPS),
+                player, service, replies::add);
+        if (replies.isEmpty()) {
+            System.err.println("current-protocol clients must not be blocked");
+            System.exit(1);
+        }
+        verify(service, atLeastOnce()).registerPlayer(any(), anyInt());
+    }
+
+    private static void versionMismatchOutranksViaGuard() {
+        ViaFixtureControl.setPlayerVersionForPlayer(PLAYER, VIA_PROTOCOL, -1);
+        if (!repliesAfterLegacyHandshake(17, mockRequestService()).isEmpty()) {
+            System.err.println("foreign protocol must stay on version-mismatch deny");
+            System.exit(1);
+        }
+        boolean priorV19 = LSSServerConfig.CONFIG.enableV19Compat;
+        LSSServerConfig.CONFIG.enableV19Compat = false;
+        try (var capture = new LssLogCapture()) {
+            repliesAfterLegacyHandshake(19, mockRequestService());
+            if (capture.rows().stream().anyMatch(row -> row.message().contains(String.valueOf(VIA_PROTOCOL)))) {
+                System.err.println("v19 with compat disabled is version mismatch, not Via denial");
+                System.exit(1);
+            }
+        } finally {
+            LSSServerConfig.CONFIG.enableV19Compat = priorV19;
+        }
+    }
+
+    private static void toggleOffIgnoresViaMismatch() {
+        LSSServerConfig.CONFIG.enableViaMismatchGuard = false;
+        ViaFixtureControl.setPlayerVersionForPlayer(PLAYER, VIA_PROTOCOL, -1);
+        var service = mockRequestService();
+        if (repliesAfterLegacyHandshake(19, service).isEmpty()) {
+            System.err.println("toggle off must ignore Via mismatch");
+            System.exit(1);
+        }
+        verify(service, atLeastOnce()).registerPlayer(any(), anyInt());
+    }
+
+    private static void viaMismatchLogsBothMinecraftProtocolNumbers() {
+        ViaFixtureControl.setPlayerVersionForPlayer(PLAYER, VIA_PROTOCOL, -1);
+        int nativeProtocol = SharedConstants.getProtocolVersion();
+        var player = mockPlayer();
+        try (var capture = new LssLogCapture()) {
+            LSSServerNetworking.handleHandshake(
+                    new HandshakeC2SPayload(19, VOXEL_CAPS),
+                    player, null, ignored -> {});
+            boolean ok = capture.rows().stream().anyMatch(row ->
+                    row.message().contains(String.valueOf(VIA_PROTOCOL))
+                            && row.message().contains(String.valueOf(nativeProtocol)));
+            if (!ok) {
+                System.err.println("expected log with both protocol numbers");
+                System.exit(1);
+            }
+        }
+    }
+
+    private static List<SessionConfigS2CPayload> repliesAfterLegacyHandshake(
+            int protocolVersion, RequestProcessingService service) {
+        var player = mockPlayer();
+        var replies = new ArrayList<SessionConfigS2CPayload>();
+        LSSServerNetworking.handleHandshake(
+                new HandshakeC2SPayload(protocolVersion, VOXEL_CAPS),
+                player, service, replies::add);
+        return replies;
+    }
+
+    private static RequestProcessingService mockRequestService() {
+        var service = mock(RequestProcessingService.class);
+        when(service.getV16CompatManager()).thenReturn(new V16CompatManager());
+        when(service.getDialectTracker()).thenReturn(new WireDialectTracker());
+        return service;
+    }
+
+    private static ServerPlayer mockPlayer() {
+        var player = mock(ServerPlayer.class);
+        when(player.getUUID()).thenReturn(PLAYER);
+        when(player.getName()).thenReturn(Component.literal("vx9m"));
+        return player;
+    }
+
+    private record LogRow(Level level, String message) {}
+
+    private static final class LssLogCapture extends AbstractAppender implements AutoCloseable {
+        private final List<LogRow> rows = new CopyOnWriteArrayList<>();
+        private final LoggerContext ctx;
+
+        LssLogCapture() {
+            super("lss-fabric-present-main-capture", null, null, true, Property.EMPTY_ARRAY);
+            start();
+            ctx = (LoggerContext) LogManager.getContext(false);
+            ctx.getConfiguration().getRootLogger().addAppender(this, Level.ALL, null);
+            ctx.updateLoggers();
+        }
+
+        @Override
+        public void append(LogEvent event) {
+            if ("LSS".equals(event.getLoggerName())) {
+                rows.add(new LogRow(event.getLevel(), event.getMessage().getFormattedMessage()));
+            }
+        }
+
+        List<LogRow> rows() {
+            return rows;
+        }
+
+        @Override
+        public void close() {
+            ctx.getConfiguration().getRootLogger().removeAppender(getName());
+            ctx.updateLoggers();
+            stop();
+        }
+    }
+}
